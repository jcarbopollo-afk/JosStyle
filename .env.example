# Variables de CLIENTE (Vite) — se usan en el navegador, deben empezar por VITE_
# Sácalas de tu proyecto de Supabase: Configuración del proyecto -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Variable de SERVIDOR (solo en Vercel, en la sección "Environment Variables" del proyecto)
# NUNCA la pongas con prefijo VITE_ ni la metas en el código del navegador — solo la lee api/ask-ai.js en el servidor
ANTHROPIC_API_KEY=

# Modelo de IA a utilizar (opcional, solo servidor). Si no se indica, api/ask-ai.js usa
# 'claude-sonnet-5' por defecto. Existe como variable para poder cambiar de modelo desde el panel
# de Vercel sin tener que tocar código ni volver a subir el proyecto.
ANTHROPIC_MODEL=
